<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- .service is a macOS bundle extension; keep the native executable extensionless. -->
    <AssemblyName>CrucibleBackend</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Rules execution lives in JVM workers; the coordinator favors a small desktop heap. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CrucibleNativeRuntimeVersion>10.0.11</CrucibleNativeRuntimeVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <!-- Use one pinned Microsoft runtime pack rather than platform-specific SDK rebuilds. -->
    <PublishAotUsingRuntimePack>false</PublishAotUsingRuntimePack>
    <IlcFrameworkPath>$(NuGetPackageRoot)microsoft.netcore.app.runtime.nativeaot.$(RuntimeIdentifier)/$(CrucibleNativeRuntimeVersion)/runtimes/$(RuntimeIdentifier)/lib/net10.0/</IlcFrameworkPath>
    <IlcFrameworkNativePath>$(NuGetPackageRoot)microsoft.netcore.app.runtime.nativeaot.$(RuntimeIdentifier)/$(CrucibleNativeRuntimeVersion)/runtimes/$(RuntimeIdentifier)/native/</IlcFrameworkNativePath>
    <IlcSdkPath>$(IlcFrameworkNativePath)</IlcSdkPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.$(RuntimeIdentifier)" Version="[$(CrucibleNativeRuntimeVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Crucible.Core/Crucible.Core.csproj" />
    <Content Include="../DeckTester/naming/nouns.txt" Link="naming/nouns.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../DeckTester/naming/pilots.json" Link="naming/pilots.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../DeckTester/notes/editorial.json" Link="notes/editorial.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
