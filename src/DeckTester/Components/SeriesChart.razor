<div class="chart" aria-label="@Title">
    <div class="chart-title"><div class="chart-heading"><h3>@Title</h3>@if(HelpText is not null){<MetricInfo Title="@Title" Text="@HelpText" />}</div><span class="muted">@(GameLength?$"Ending {AxisUnit}":Rounds?"Ending Rounds":"Actual Player Turns")</span></div>
    <AiNote Scope="chart" Subject="@(NoteRunId is null?Title:$"{NoteRunId}:{Title}")" FallbackSubject="@Title" />
    @if(Series.All(s=>s.Points.Count==0)){<p class="muted">@(GameLength?"No completed games yet.":"No turn-end measurements yet.")</p>}
    else{
        <div class="series-plot">
        <div class="series-scale chart-range" aria-label="Value Scale"><span>@ValueLabel(Maximum)</span><span>@ValueLabel(Minimum)</span></div>
        <div class="series-plot-area">
        <svg viewBox="0 0 600 160" preserveAspectRatio="none" aria-hidden="true">
            <line x1="8" y1="145" x2="592" y2="145" class="gridline" /><line x1="8" y1="77" x2="592" y2="77" class="gridline" /><line x1="8" y1="10" x2="592" y2="10" class="gridline" />
            @if(MaxTurn>=5){<line x1="@TurnFiveX" y1="10" x2="@TurnFiveX" y2="@(MaxTurn>5?172:160)" class="turn-five-guide" vector-effect="non-scaling-stroke" />}
            @foreach(var s in Series){<polyline points="@Points(s.Points)" fill="none" stroke="@s.Color" stroke-width="2.5" vector-effect="non-scaling-stroke" />@if(GameLength){@foreach(var p in s.Points){<circle cx="@TurnX(p.Turn).ToString("0.##",CultureInfo.InvariantCulture)" cy="@PointY(p.Value).ToString("0.##",CultureInfo.InvariantCulture)" r="3" fill="@s.Color" />}}}
        </svg>
        <div class="series-hover-layer" aria-label="@($"Explore {AxisUnit}s")">
            @for(var turn=1;turn<=MaxTurn;turn++){
                var left=turn==1?0:(TurnX(turn-1)+TurnX(turn))/2;
                var right=turn==MaxTurn?600:(TurnX(turn)+TurnX(turn+1))/2;
                var anchor=(TurnX(turn)-left)/(right-left)*100;
                <button type="button" class="series-hover-turn @(turn==1?"first-turn":turn==MaxTurn?"last-turn":"")" aria-label="@($"{AxisUnit} {turn}")" style="left:@Percent(left/600*100);width:@Percent((right-left)/600*100);--turn-anchor:@Percent(anchor)"><span class="series-hover-guide" aria-hidden="true"></span><span class="series-hover-label">@AxisUnit @turn</span></button>
            }
        </div>
        </div>
        </div>
        <div class="chart-axis series-turn-axis @(MaxTurn>5?"has-turn-five":"")"><span>@AxisUnit 1</span>@if(MaxTurn>5){<span class="turn-five-label" style="left:@((TurnX(5)/600*100).ToString("0.##",CultureInfo.InvariantCulture))%">@AxisUnit 5</span>}<span class="@(MaxTurn==5?"turn-five-end":"")">@AxisUnit @MaxTurn</span></div>
        <div class="legend">@foreach(var s in Series){<span><i style="background:@s.Color"></i>@if(s.Deck is not null){@if(GameLength){<SourceWinRate Deck="s.Deck"><DeckIdentity Deck="s.Deck" Compact="true" SingleRow="true" /></SourceWinRate>}else{<DeckIdentity Deck="s.Deck" Compact="true" SingleRow="true" />}}else{@s.Name}</span>}</div>
        <details><summary>@(GameLength?"Win Rates and Games Ending at Each Length":"Measurements and Active-Game Counts")</summary><div class="table-scroll"><table><thead><tr><SortHeader State="tableSort" Column="deck" OnSort="tableSort.Toggle">Deck</SortHeader><SortHeader State="tableSort" Column="turn" OnSort="tableSort.Toggle">@(GameLength?$"Ending {AxisUnit}":Rounds?"Ending Round":"Actual Turn")</SortHeader><SortHeader State="tableSort" Column="value" OnSort="tableSort.Toggle">@(GameLength?"Win Rate":"Mean")</SortHeader><SortHeader State="tableSort" Column="count" OnSort="tableSort.Toggle">@(GameLength?"Completed Games":"Observed Games")</SortHeader></tr></thead><tbody>@foreach(var row in TableRows()){<tr><td>@if(row.Deck is not null){<DeckIdentity Deck="row.Deck" Compact="true" Stacked="true" />}else{@row.Name}</td><td>@row.Point.Turn</td><td>@if(GameLength){<SourceWinRate Deck="row.Deck">@ValueLabel(row.Point.Value)</SourceWinRate>}else{@ValueLabel(row.Point.Value)}</td><td>@row.Point.Count</td></tr>}</tbody></table></div></details>
    }
</div>
@code{
    private readonly TableSort tableSort=new();
    private IEnumerable<(string Name,DeckManifest? Deck,ChartPoint Point)> TableRows()=>tableSort.Apply(
        Series.SelectMany(s=>s.Points.Select(p=>(Name:s.Name,Deck:s.Deck,Point:p))),
        (row,column)=>column switch{"deck"=>row.Name,"turn"=>row.Point.Turn,"value"=>row.Point.Value,"count"=>row.Point.Count,_=>(IComparable?)null});

    [Parameter]public string? NoteRunId{get;set;}
    [Parameter]public string Title{get;set;}="";
    [Parameter]public string? HelpText{get;set;}
    [Parameter]public bool GameLength{get;set;}
    [Parameter]public bool Rounds{get;set;}=true;
    [Parameter]public List<ChartSeries> Series{get;set;}=[];
    private int MaxTurn=>Math.Max(2,Series.SelectMany(s=>s.Points).Select(p=>p.Turn).DefaultIfEmpty(2).Max());
    private string AxisUnit=>Rounds?"Round":"Turn";
    private string ValueLabel(double value)=>Math.Ceiling(value).ToString("0",CultureInfo.InvariantCulture)+(GameLength?"%":"");
    private double Minimum=>GameLength?0:Math.Min(0,Series.SelectMany(s=>s.Points).Select(p=>p.Value).DefaultIfEmpty(0).Min());
    private double Maximum=>GameLength?100:Math.Max(1,Series.SelectMany(s=>s.Points).Select(p=>p.Value).DefaultIfEmpty(1).Max());
    private double PointY(double value)=>145-(value-Minimum)*135/(Maximum-Minimum);
    private double TurnX(int turn)=>8+(turn-1)*584.0/(MaxTurn-1);
    private string TurnFiveX=>TurnX(5).ToString("0.##",CultureInfo.InvariantCulture);
    private static string Percent(double value)=>value.ToString("0.####",CultureInfo.InvariantCulture)+"%";
    private string Points(List<ChartPoint> data)=>string.Join(" ",data.Select(p=>$"{TurnX(p.Turn).ToString("0.##",CultureInfo.InvariantCulture)},{PointY(p.Value).ToString("0.##",CultureInfo.InvariantCulture)}"));
}
