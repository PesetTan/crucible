<details class="engagement-protocols">
    <summary>Engagement Protocols · Preview</summary>
    @if(Catalog is {} catalog){
        <p class="small muted">This catalog was frozen with the session. Recorded pilots and optimizer policy determine which sets were enabled.</p>
        @if(catalog.Sets is {Count:>1}){
            <label for="saved-protocol-profile">Pilot protocol set</label><AppSelect Id="saved-protocol-profile" Label="Pilot protocol set" Options="catalog.Sets.Keys.Select(p=>new SelectOption(p,p)).ToList()" @bind-Value="profile" />
        }
        <EngagementProtocolCards Catalog="catalog" Profile="@(profile.Length>0?profile:null)" />
    }else{<p class="small muted">Protocol definitions are unavailable from the active engine bundle.</p>}
</details>
@code {
    [Parameter] public ProtocolCatalog? Catalog { get; set; }
    private string profile=ReanimatorPilots.Engagement;
}
