<span class="deck-colors" role="img" aria-label="@DeckDisplay.Colors(Deck)" title="@DeckDisplay.Colors(Deck)">
    <span class="mana-symbols" aria-hidden="true">
        @foreach (var symbol in DeckDisplay.Symbols(Deck)) { <ManaLogo Symbol="symbol" /> }
    </span>
</span>
@code {
    [Parameter, EditorRequired] public DeckManifest Deck { get; set; } = default!;
}
