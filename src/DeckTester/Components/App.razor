@inject BrandSettings Branding
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#e8e8ee" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <script src="@Assets["theme.js"]"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" />
    <link rel="preload" href="assets/mana/crucible-mana.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="branding.css" />
    <link rel="stylesheet" href="DeckTester.styles.css" />
    <link rel="stylesheet" href="@Assets["theme-polish.css"]" />
    <link rel="icon" type="@Branding.IconType" href="@Branding.Icon" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["source-rate.js"]"></script>
    <script src="@Assets["disclosures.js"]"></script>
    <script src="@Assets["motion.js"]"></script>
</body>
</html>
