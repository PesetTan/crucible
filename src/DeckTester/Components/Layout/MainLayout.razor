@inherits LayoutComponentBase
@inject BrandSettings Branding
<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="Crucible home"><span class="brand-logo-wrap"><span class="brand-logo" aria-hidden="true"><span class="brand-logo-bowl" style="--brand-mask:url('@Branding.LogoBowl')"></span><span class="brand-logo-flame" style="--brand-mask:url('@Branding.LogoFlame')"></span></span></span><span>Crucible<small>STANDARD · BO1</small></span></a>
        <div class="nav-label">WORKSPACE</div>
        <nav><NavLink href="/" Match="NavLinkMatch.All"><span aria-hidden="true"></span> Deck Tester</NavLink><NavLink href="/decks"><span aria-hidden="true"></span> Deck Library</NavLink><NavLink href="/workshop"><span aria-hidden="true"></span> Deck Workshop</NavLink><NavLink href="/pilots"><span aria-hidden="true"></span> Forge Pilots</NavLink><NavLink href="/runs"><span aria-hidden="true"></span> Run History</NavLink></nav>
        <div class="sidebar-utilities">
        <div class="sidebar-note" tabindex="0" aria-describedby="local-execution-help">
            <span class="sidebar-note-title"><span class="status-dot"></span> Local Execution</span>
            <p>Full games. Turns logged.<br />No model calls during play.</p>
            <div class="sidebar-note-tooltip" id="local-execution-help" role="tooltip">
                <strong>How deck testing works</strong>
                <dl>
                    <dt>Local execution</dt>
                    <dd>Games run on this computer using the Forge rules engine.</dd>
                    <dt>Full games, turns logged</dt>
                    <dd>Each game plays through to an outcome. Turn events are saved for replay.</dd>
                    <dt>No model calls during play</dt>
                    <dd>The automated pilot chooses actions without contacting an AI model during a game.</dd>
                </dl>
            </div>
        </div>
        <button type="button" class="theme-switch" role="switch" aria-label="Dark theme" aria-checked="false" title="Switch to dark theme" data-theme-switch>
            <svg class="theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 13.1A8.5 8.5 0 0 1 10.9 3.5 8.5 8.5 0 1 0 20.5 13.1Z" /></svg>
            <svg class="theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        </div>
    </aside>
    <div class="main"><main>@Body</main><footer>Forge Rules Engine · London Mulligans · Automated Pilot Results</footer></div>
</div>
<div id="blazor-error-ui">The connection was interrupted. <a href="">Reload the App</a><a class="dismiss">×</a></div>
