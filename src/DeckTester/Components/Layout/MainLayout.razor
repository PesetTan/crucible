@inherits LayoutComponentBase
@inject BrandSettings Branding
<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="Gauntlet home"><span class="brand-logo-wrap"><img class="brand-logo" src="@Branding.Logo" alt="" width="44" height="44" /></span><span>Gauntlet<small>STANDARD · BO1</small></span></a>
        <div class="nav-label">WORKSPACE</div>
        <nav><NavLink href="/" Match="NavLinkMatch.All"><span aria-hidden="true"></span> Deck Tester</NavLink><NavLink href="/decks"><span aria-hidden="true"></span> Deck Library</NavLink><NavLink href="/runs"><span aria-hidden="true"></span> Run History</NavLink></nav>
        <div class="sidebar-note" tabindex="0" aria-describedby="local-execution-help">
            <span class="status-dot"></span> Local Execution
            <p>Full games. Turns logged.<br />No model calls during play.</p>
            <div class="sidebar-note-tooltip" id="local-execution-help" role="tooltip">
                <strong>How deck testing works</strong>
                <dl>
                    <dt>Local execution</dt>
                    <dd>Games run on this computer using the Forge rules engine.</dd>
                    <dt>Full games, turns logged</dt>
                    <dd>Each game plays through to an outcome. Turn events are saved for replay.</dd>
                    <dt>No model calls during play</dt>
                    <dd>The automated pilot chooses actions without contacting an AI model during a game.</dd>
                </dl>
            </div>
        </div>
    </aside>
    <div class="main"><main>@Body</main><footer>Forge Rules Engine · London Mulligans · Automated Pilot Results</footer></div>
</div>
<div id="blazor-error-ui">The connection was interrupted. <a href="">Reload the App</a><a class="dismiss">×</a></div>
