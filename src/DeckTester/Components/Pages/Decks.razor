@page "/decks"
@using Microsoft.JSInterop
@inject IUiBackend Store
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IAsyncDisposable
@if((historyError??Store.ConnectionError) is {} connectionError){<div class="error" role="status">@connectionError</div>}
<PageTitle>Deck Library — Crucible</PageTitle>
<div class="eyebrow">EXACT LISTS / IMMUTABLE SNAPSHOTS</div><div class="section-head"><h1>Deck Library.</h1><button disabled="@(Store.ConnectionError is not null)" @onclick="Import">Check Source Snapshot</button></div>
<p class="lead">Public lists, saved snapshots, and custom workshop versions keep their own provenance.<br />Each run is tied to an exact list. Expand a deck to inspect its cards, previous runs, or source.</p>
<AiNote Scope="page" Subject="library" />
<p class="small muted">Archetype tiers: <a href="https://mtga.untapped.gg/constructed/standard/tier-list" target="_blank" rel="noreferrer">Untapped.gg</a> · Standard Bo1 · Bronze–Platinum · September 29–October 11, 2026. Ratings describe the archetype, not simulated results.</p>
<div class="deck-navigation" role="navigation" aria-label="Deck navigation">
    <label for="library-deck">Choose Deck</label>
    <DeckSelect Id="library-deck" Label="Choose Deck" Placeholder="Jump to a deck…" Decks="decks" @bind-Value="selectedDeck" @bind-Value:after="JumpToDeck" />
</div>
@if(message is not null){<div class="notice">@message</div>}
@foreach(var group in decks.GroupBy(d=>d.Strategy).OrderBy(g=>StrategyOrder(g.Key))){
<h2 class="library-strategy-heading">@DeckStrategy.Label(group.Key) <span class="muted">· @group.Count() decks</span></h2>
@foreach(var deck in group){
    <LibraryDeck @key="deck.Id" Deck="deck" Coverage="coverageByDeck[deck.Id]" ManaValues="manaValues" History="historyByDeck.GetValueOrDefault(deck.Id,[])" HistoryAvailable="historyAvailable" />
}
}
@code{
    private static int StrategyOrder(string? strategy) => strategy switch {"aggro"=>0,"aggro-control"=>1,"aggro-combo"=>2,"control"=>3,"control-combo"=>4,"combo"=>5,_=>6};
    private async Task PollConnection(){try{using var timer=new PeriodicTimer(TimeSpan.FromSeconds(10));while(await timer.WaitForNextTickAsync(connectionLifetime.Token))await InvokeAsync(async()=>{if(await LoadLibrary())StateHasChanged();});}catch(OperationCanceledException){}}
    private readonly CancellationTokenSource connectionLifetime=new();

    private Dictionary<int, int> manaValues = new();
    private List<DeckManifest> decks=[];
    private Dictionary<string,DeckCoverage> coverageByDeck=[];
    private LibrarySnapshot? library;
    private Dictionary<string,List<HistoryRun>> historyByDeck=[];
    private string? historyFingerprint;
    private bool historyAvailable;
    private string selectedDeck="";
    private Microsoft.JSInterop.IJSObjectReference? navigationModule;
    protected override async Task OnInitializedAsync(){await LoadLibrary();_ = PollConnection();}
    private async Task<bool> LoadLibrary(){
        var previousError=historyError??Store.ConnectionError;
        var next=await Store.LibraryState(connectionLifetime.Token);
        var libraryError=Store.ConnectionError;
        var changed=next is not null&&!ReferenceEquals(next,library);
        if(changed){
            library=next;manaValues=next!.ManaValues;
            coverageByDeck=next.Decks.ToDictionary(d=>d.Manifest.Id,d=>d.Coverage);
            decks=next.Decks.Select(d=>d.Manifest).OrderBy(d=>d.SourceType).ThenBy(DeckDisplay.Text).ToList();
        }
        var history=await Store.History(connectionLifetime.Token);
        historyError=Store.ConnectionError??libraryError;
        if(history is not null){
            var fingerprint=DeckImporter.Hash(Json.Encode(history.Sessions));
            if(fingerprint!=historyFingerprint){
                historyFingerprint=fingerprint;historyAvailable=true;
                historyByDeck=history.Sessions.SelectMany(s=>s.Progress.Run.Config.DeckIds.Select(id=>(id,session:s)))
                    .GroupBy(x=>x.id).ToDictionary(g=>g.Key,g=>g.Select(x=>x.session).OrderByDescending(s=>s.Progress.Run.CreatedAt).ToList());
                changed=true;
            }
        }
        return changed||previousError!=(historyError??Store.ConnectionError);
    }
    private async Task JumpToDeck(){
        if(!decks.Any(d=>d.Id==selectedDeck))return;
        navigationModule??=await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import","./deck-navigation.js?v=1");
        await navigationModule.InvokeVoidAsync("jumpToDeck",selectedDeck);
    }
    public async ValueTask DisposeAsync(){connectionLifetime.Cancel();connectionLifetime.Dispose();if(navigationModule is not null)try{await navigationModule.DisposeAsync();}catch(Microsoft.JSInterop.JSDisconnectedException){}}
    private string? historyError;
    private string? message;private async Task Import(){try{var d=await Store.Import();await LoadLibrary();message=$"Checked {d.Count} exact source lists. Existing run manifests remain unchanged.";}catch(Exception e){message=e.Message;}}
}
